# Copy this file to .env before deploying.
# Do not commit the real .env file.

MYSQL_ROOT_PASSWORD=change_this_to_a_long_random_password
MYSQL_DATABASE=ShopHub

# On a cloud VM, use 80 so visitors can open http://SERVER_IP directly.
# For local testing, change this to 8080 if port 80 is already in use.
PUBLIC_HTTP_PORT=80

# Keep the Spring Boot container small enough for free-tier machines.
JAVA_OPTS=-Xms128m -Xmx512m

TZ=UTC
